<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ dataset_name }} - dataforge</title>
  <style>
    :root { --accent: #2563eb; --bg: #0f172a; --panel: #1e293b; --text: #e2e8f0; --muted: #94a3b8; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: var(--bg); color: var(--text); }
    header { padding: 1.5rem 2rem; background: var(--panel); border-bottom: 1px solid #334155; }
    header h1 { margin: 0; font-size: 1.4rem; }
    nav { margin-top: 0.75rem; }
    nav a { color: var(--muted); text-decoration: none; margin-right: 1.25rem; font-size: 0.9rem; }
    nav a:hover { color: var(--accent); }
    main { padding: 2rem; max-width: 1100px; margin: 0 auto; }
    .card { background: var(--panel); border: 1px solid #334155; border-radius: 10px; padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; }
    table.dataforge-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    table.dataforge-table th, table.dataforge-table td { border-bottom: 1px solid #334155; padding: 0.5rem 0.6rem; text-align: left; }
    table.dataforge-table th { color: var(--accent); position: sticky; top: 0; background: var(--panel); }
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; }
    .stat { background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 0.75rem 1rem; }
    .stat .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .stat .value { font-size: 1.4rem; font-weight: 600; }
    footer { text-align: center; padding: 2rem; color: var(--muted); font-size: 0.8rem; }
    code { background: #0f172a; padding: 0.1rem 0.4rem; border-radius: 4px; }
  </style>
</head>
<body>
  <header>
    <h1>{{ dataset_name }}</h1>
    <nav>
      <a href="index.html">Summary</a>
      <a href="schema.html">Schema</a>
      {% if has_charts or charts %}<a href="charts.html">Charts</a>{% endif %}
    </nav>
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
  <footer>Generated by dataforge-cli</footer>
</body>
</html>

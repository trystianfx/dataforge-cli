{% extends "base.html.j2" %}
{% block content %}
  <div class="card">
    <h2>Inferred schema</h2>
    <p>{{ schema.column_count }} fields across {{ schema.row_count }} rows.</p>
    <div class="table-scroll">
      <table class="dataforge-table">
        <thead>
          <tr><th>Field</th><th>Type</th><th>Nullable</th><th>Unique</th><th class="wrap">Sample values</th></tr>
        </thead>
        <tbody>
          {% for f in schema.fields %}
          <tr>
            <td><code>{{ f.name }}</code></td>
            <td>{{ f.type }}</td>
            <td>{{ "yes" if f.nullable else "no" }}</td>
            <td>{{ f.unique_count }}</td>
            <td class="wrap">{{ f.sample_values | join(", ") }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}

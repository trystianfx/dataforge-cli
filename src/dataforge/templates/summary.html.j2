{% extends "base.html.j2" %}
{% block content %}
  <div class="card">
    <h2>Dataset overview</h2>
    <div class="stat-grid">
      <div class="stat"><div class="label">Rows</div><div class="value">{{ profile.rows }}</div></div>
      <div class="stat"><div class="label">Columns</div><div class="value">{{ profile.columns }}</div></div>
      <div class="stat"><div class="label">Duplicate rows</div><div class="value">{{ profile.duplicate_rows }}</div></div>
      <div class="stat"><div class="label">Memory (bytes)</div><div class="value">{{ profile.memory_usage_bytes }}</div></div>
    </div>
  </div>
  <div class="card">
    <h2>Preview</h2>
    {% if layout == "table" %}
      <div class="table-scroll">
        {{ table_html | safe }}
      </div>
      <p style="color: var(--muted); font-size: 0.8rem; margin-top: 0.75rem;">
        Wide table? Scroll horizontally, or rebuild with <code>--layout cards</code> /
        <code>--layout grid</code> for a card-based, no-scroll view.
      </p>
    {% else %}
      <div class="record-cards layout-{{ 'flex' if layout == 'cards' else 'grid' }}">
        {% for record in records %}
        <div class="record-card">
          <div class="record-card-title">{{ record.values() | list | first }}</div>
          {% for key, value in record.items() %}
          <div class="field-row">
            <span class="field-label">{{ key }}</span>
            <span class="field-value">{{ value if value is not none else "" }}</span>
          </div>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endblock %}
